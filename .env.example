# Target Website URLs to monitor (Pisahkan dengan koma atau gunakan satu URL)
# Contoh: TARGET_URLS=https://deploy.fedora.biz.id/, https://google.com, https://github.com
TARGET_URLS=https://deploy.fedora.biz.id/
# Atau tetap menggunakan format tunggal TARGET_URL=...
# TARGET_URL=https://deploy.fedora.biz.id/

# ==========================================
# METODE 1: DISCORD WEBHOOK (Sederhana untuk notifikasi)
# ==========================================
# Dapatkan dari: Server Discord -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ==========================================
# METODE 2: DISCORD BOT TOKEN (Untuk Interactive Bot / Notifikasi Bot)
# ==========================================
# Dapatkan dari: Discord Developer Portal -> Applications -> Bot -> Reset/Copy Token
# DISCORD_BOT_TOKEN=MTAxMjM0NTY3ODkw...
# ID Channel tempat bot mengirim pesan (Klik kanan channel Discord -> Copy Channel ID)
# DISCORD_CHANNEL_ID=123456789012345678

# Monitoring Check Interval (in seconds)
CHECK_INTERVAL_SECONDS=60

# Request Timeout (in seconds)
REQUEST_TIMEOUT_SECONDS=10

# Number of consecutive failures required before sending a DOWN alert
# Set to 1 for instant alert, or 2 to avoid temporary single-glitch alerts
FAILURE_THRESHOLD=1

# Optional mention in Discord message when DOWN (e.g. @everyone or <@&ROLE_ID> or <@USER_ID>)
# Kosongkan jika tidak ingin mention
ALERT_MENTION=

# Response time threshold in milliseconds for degraded/slow warning (0 to disable)
DEGRADED_LATENCY_THRESHOLD_MS=3000
